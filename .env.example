# ==============================================================================
# AI-Powered Candidate Intelligence and Job Readiness Platform (.env.example)
# ==============================================================================

# Application Information
APP_NAME="AI Candidate Intelligence Platform"
APP_VERSION="1.0.0"
DEBUG=True

# Database Configuration
DATABASE_URL="sqlite+aiosqlite:///./candidate_app.db"
# DATABASE_URL="postgresql+asyncpg://postgres:postgrespassword@localhost:5432/candidate_db"

# AI & LLM Settings (Google Gemini)
GEMINI_API_KEY="your-actual-gemini-api-key-here"
LLM_MODEL="gemini-1.5-flash"
USE_MOCK_LLM=True

# Embedding & RAG Vector Settings
VECTOR_DIMENSION=1536
